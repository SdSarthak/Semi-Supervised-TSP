# Copy to .env and adjust as needed. This project talks to no external
# services, so there are no API keys or credentials here -- only local
# runtime settings.

# Where solutions, plots and videos are written.
TSP_EXPORT_DIR=./exports

# Default random seed used for data generation and the stochastic solvers.
TSP_SEED=42

# Matplotlib backend. Set to Agg on a headless machine to skip the GUI
# toolkit probe entirely. Leave unset to auto-detect.
# MPLBACKEND=Agg
